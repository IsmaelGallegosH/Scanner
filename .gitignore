# Entorno Python
Sistema/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Datos de entrada / salida (PDFs y OCR) — no versionar
Libreria/entrada/*
!Libreria/entrada/.gitkeep
Libreria/salida/*
!Libreria/salida/.gitkeep

# Textos OCR, reescritos y versiones (por si aparecen fuera de salida/)
*.txt
!Sistema/requirements.txt
!**/.gitkeep
*.raw.txt
reescrito.txt
pagina_*.txt
*_v*.txt
*_v*.tex
*_v*.pdf
*_ocr.txt

# Modelos OCR descargados y aprendizaje local
Sistema/modelos/*
!Sistema/modelos/.gitkeep
Sistema/aprendizaje/*
!Sistema/aprendizaje/.gitkeep

# Logs y temporales
*.log
Sistema/scanner_ui.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.code-workspace

# LaTeX auxiliar
*.aux
*.out
*.toc
*.synctex.gz

# Desktop launchers locales
*.desktop
